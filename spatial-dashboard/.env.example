# Geoxis: environment variables. Copy to .env.local for local dev;
# set the same names in Vercel → Settings → Environment Variables. Never commit real values.

# ── Added 2026-09-25: keys the code reads that were not listed here ──
# Required
# Cixy's AI (console.anthropic.com → API keys). Server only.
ANTHROPIC_API_KEY=
# Transactional email (resend.com). Needed for support/sign-in emails.
RESEND_API_KEY=
# Supabase anon/publishable key.
SUPABASE_ANON_KEY=
# Supabase service_role key. Server only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase project URL (server).
SUPABASE_URL=
# This site's Apixis Wallet key (apx_live_…). From `npm run family-keys` in ApixisWallet. Server only.
WALLET_API_KEY=
# Optional
# Wallet base URL. Default https://apixis-wallet.vercel.app
APIXIS_WALLET_API_URL=
# Public site URL, e.g. https://<site>.vercel.app
APP_URL=
# Legacy names (leave unset)
# Legacy name for WALLET_API_KEY. Leave unset.
# APIXIS_WALLET_API_KEY=

# Apixis sign-in (server only; registered with the shared Wallet)
APIXIS_CLIENT_ID=geoxis
# Optional override; defaults to APP_URL + /auth/apixis/callback
APIXIS_REDIRECT_URI=
# World onboarding; product-scoped key from the Apixis hub
APIXIS_WORLD_KEY=
# Optional hub base URL; defaults to https://www.apixis.dev
APIXIS_WORLD_API=
# Optional Cixy model override and additional owner admin emails
AI_MODEL=
ADMIN_EMAILS=
